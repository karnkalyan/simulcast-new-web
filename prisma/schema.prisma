generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SiteSettings {
  id              String   @id @default("main") @db.VarChar(36)
  companyName     String   @default("Simulcast Technologies Pvt. Ltd.")
  headline        String   @default("Technology that connects what matters.")
  subheadline     String   @db.Text
  slogan          String   @default("Integrated Broadcast & Technology Solutions")
  website         String   @default("https://www.simulcast.com.np")
  publicEmail     String   @default("")
  phone           String   @default("")
  address         String   @default("Nepal")
  facebook        String   @default("")
  linkedin        String   @default("")
  youtube         String   @default("")
  instagram       String   @default("")
  seoDescription  String   @db.Text
  primaryColor    String   @default("#2b0d3a") @db.VarChar(32)
  secondaryColor  String   @default("#e11d72") @db.VarChar(32)
  heroBgColor     String   @default("#f5f7fd") @db.VarChar(32)
  heroBadgeText   String   @default("INTEGRATED TECHNOLOGY · BUILT IN NEPAL") @db.VarChar(191)
  heroEmphasis    String   @default("Connected by design.") @db.VarChar(191)
  customCss       String?  @db.Text
  enableChat      Boolean  @default(true)
  chatGreeting    String   @default("Hello! Welcome to Simulcast Technologies. How can we help you with our broadcast, software, AI and IT solutions?") @db.VarChar(1000)
  mcpApiKey       String   @default("simulcast_master_mcp_api_key_2026_sec") @db.VarChar(255)
  escalationEmail String   @default("info@simulcast.com.np,support@simulcast.com.np") @db.VarChar(255)
  supportEmail    String   @default("support@simulcast.com.np") @db.VarChar(255)
  updatedAt       DateTime @updatedAt
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(191)
  title     String   @db.VarChar(191)
  eyebrow   String   @default("")
  summary   String   @db.Text
  body      String   @db.LongText
  icon      String   @default("layers")
  imageUrl  String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(191)
  title     String   @db.VarChar(191)
  category  String   @default("Technology")
  summary   String   @db.Text
  body      String   @db.LongText
  imageUrl  String   @default("")
  location  String   @default("Nepal")
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(191)
  title       String    @db.VarChar(191)
  excerpt     String    @db.Text
  body        String    @db.LongText
  imageUrl    String    @default("")
  category    String    @default("Insights")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String        @db.VarChar(191)
  email         String        @db.VarChar(191)
  organization  String        @default("")
  phone         String        @default("")
  interest      String        @default("")
  message       String        @db.Text
  status        InquiryStatus @default(NEW)
  internalNotes String        @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String   @db.VarChar(191)
  path      String   @db.VarChar(255)
  mimeType  String   @db.VarChar(100)
  size      Int
  alt       String   @default("")
  createdAt DateTime @default(now())
}

enum ChatStatus {
  ACTIVE
  ESCALATED_HUMAN
  CLOSED
}

model ChatSession {
  id             String        @id @default(cuid())
  visitorId      String        @db.VarChar(191)
  visitorName    String        @default("Website Visitor") @db.VarChar(191)
  visitorEmail   String        @default("") @db.VarChar(191)
  visitorPhone   String        @default("") @db.VarChar(64)
  status         ChatStatus    @default(ACTIVE)
  escalatedAt    DateTime?
  closedAt       DateTime?
  summary        String?       @db.Text
  transcriptSent Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       ChatMessage[]

  @@index([visitorId])
  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender     String      @db.VarChar(32) // "user" | "bot" | "human_agent" | "system"
  senderName String      @db.VarChar(191)
  content    String      @db.Text
  createdAt  DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(191)
  token       String    @unique @db.VarChar(191)
  role        String    @default("MCP_CLIENT") @db.VarChar(64)
  description String    @default("") @db.VarChar(255)
  revoked     Boolean   @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CustomRoute {
  id           String    @id @default(cuid())
  path         String    @unique @db.VarChar(191)
  name         String    @db.VarChar(191)
  description  String    @default("") @db.VarChar(255)
  method       String    @default("ALL") @db.VarChar(16)
  contentType  String    @default("application/json") @db.VarChar(100)
  statusCode   Int       @default(200)
  responseBody String    @db.LongText
  headers      String?   @db.Text
  enabled      Boolean   @default(true)
  hitCount     Int       @default(0)
  lastHitAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([path])
  @@index([enabled])
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model EmailQueueItem {
  id          String      @id @default(cuid())
  to          String      @db.VarChar(255)
  cc          String?     @db.VarChar(255)
  bcc         String?     @db.VarChar(255)
  subject     String      @db.VarChar(255)
  html        String      @db.LongText
  text        String?     @db.Text
  attachments String?     @db.LongText
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)
  priority    Int         @default(0)
  batchId     String?     @db.VarChar(64)
  source      String      @default("MCP") @db.VarChar(64)
  scheduledAt DateTime    @default(now())
  sentAt      DateTime?
  failedAt    DateTime?
  lastError   String?     @db.Text
  messageId   String?     @db.VarChar(191)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([batchId])
  @@index([scheduledAt])
  @@index([createdAt])
}

model EmailLog {
  id              String   @id @default(cuid())
  queueItemId     String?  @db.VarChar(64)
  to              String   @db.VarChar(255)
  subject         String   @db.VarChar(255)
  status          String   @default("SENT") @db.VarChar(32)
  source          String   @default("MCP") @db.VarChar(64)
  messageId       String?  @db.VarChar(191)
  error           String?  @db.Text
  hasAttachments  Boolean  @default(false)
  attachmentNames String?  @db.VarChar(255)
  clientIdentity  String?  @db.VarChar(191)
  createdAt       DateTime @default(now())

  @@index([to])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   @db.VarChar(64)
  category  String   @default("MCP") @db.VarChar(32)
  actor     String   @default("system") @db.VarChar(191)
  target    String?  @db.VarChar(255)
  details   String?  @db.Text
  ipAddress String?  @db.VarChar(64)
  status    String   @default("SUCCESS") @db.VarChar(32)
  createdAt DateTime @default(now())

  @@index([action])
  @@index([category])
  @@index([createdAt])
}


model McpConnection {
  id           String    @id @default(cuid())
  clientName   String    @db.VarChar(191)
  clientId     String    @unique @db.VarChar(191)
  token        String    @db.LongText
  tokenPrefix  String    @db.VarChar(64)
  role         String    @default("MCP_CLIENT") @db.VarChar(64)
  scopes       String    @default("all") @db.VarChar(255)
  status       String    @default("CONNECTED") @db.VarChar(32) // CONNECTED, DISCONNECTED
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(255)
  requestCount Int       @default(0)
  lastTool     String?   @db.VarChar(128)
  expiresAt    DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([tokenPrefix])
}

model McpConnectionLog {
  id           String   @id @default(cuid())
  connectionId String?  @db.VarChar(64)
  clientName   String   @db.VarChar(191)
  event        String   @db.VarChar(64) // AUTHORIZE, CONNECT, TOOL_CALL, DISCONNECT, RECONNECT, BLOCKED
  toolName     String?  @db.VarChar(128)
  status       String   @default("SUCCESS") @db.VarChar(32) // SUCCESS, FAILED, REVOKED
  ipAddress    String?  @db.VarChar(64)
  details      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([connectionId])
  @@index([event])
  @@index([createdAt])
}

model McpCustomTool {
  id            String    @id @default(cuid())
  name          String    @unique @db.VarChar(128)
  title         String    @db.VarChar(191)
  description   String    @db.Text
  category      String    @default("Custom") @db.VarChar(64)
  enabled       Boolean   @default(true)
  parameters    String    @db.LongText // JSON schema
  handlerType   String    @default("WEBHOOK") @db.VarChar(64) // WEBHOOK, DYNAMIC_TEMPLATE, EMAIL_ALERT, DATABASE_QUERY
  handlerConfig String    @db.LongText // JSON config
  runCount      Int       @default(0)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled])
}

